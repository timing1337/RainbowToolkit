<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RainbowToolkit.UI.ViewModels"
        xmlns:views="using:RainbowToolkit.UI.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="760"
        x:Class="RainbowToolkit.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="RainbowToolkit"
        Width="1280" Height="760"
        MinWidth="900" MinHeight="560"
        Background="{StaticResource WindowBackgroundBrush}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="32">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="32,*">
        <!-- Row 0 is the extended title bar (drag area + system caption buttons). -->

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="260" MaxWidth="600" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.Styles>
                <Style Selector="GridSplitter">
                    <Setter Property="Template">
                        <ControlTemplate>
                            <Border Background="Transparent" Width="5">
                                <Border Width="1"
                                        HorizontalAlignment="Center"
                                        Background="{StaticResource DividerBrush}" />
                            </Border>
                        </ControlTemplate>
                    </Setter>
                </Style>
            </Grid.Styles>

            <views:DirectoryPanel Grid.Column="0" />

            <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

            <!-- Content area: intentionally empty, this is where asset views will live. -->
            <Panel Grid.Column="2" Background="{StaticResource WindowBackgroundBrush}" />
        </Grid>
    </Grid>
</Window>
